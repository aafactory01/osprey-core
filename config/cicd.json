{
  "schema_version": "1.0.0",
  "source_label": "Delivery pipeline configuration (config/cicd.json): Cloud Build CI runs at S5_RELEASE_GATE and Google Cloud Deploy CD runs at S6_DEPLOY_CLOSE.",
  "project_id": "gement02",
  "region": "us-central1",
  "service": "osprey-core",
  "runtime_service_account": "osprey-core-run@gement02.iam.gserviceaccount.com",
  "stage_ids": {
    "spec": "S1_SPEC",
    "tests": "S2_TESTS",
    "build": "S3_BUILD",
    "verify": "S4_VERIFY_QA",
    "release_gate": "S5_RELEASE_GATE",
    "deploy_close": "S6_DEPLOY_CLOSE"
  },
  "ci": {
    "provider": "Cloud Build",
    "config_file": "cloudbuild.yaml",
    "image_repository": "us-central1-docker.pkg.dev/gement02/osprey-scion/osprey-core"
  },
  "cd": {
    "provider": "Google Cloud Deploy",
    "config_file": "clouddeploy.yaml",
    "skaffold_file": "skaffold.yaml",
    "service_manifest": "run-service.yaml",
    "delivery_pipeline": "osprey-core-cd",
    "target": "osprey-core-prod",
    "execution_service_account": "osprey-onboard-sa@gement02.iam.gserviceaccount.com",
    "image_name": "osprey-core"
  },
  "provenance_env": {
    "commit_sha": "OSPREY_COMMIT_SHA",
    "short_sha": "OSPREY_SHORT_SHA",
    "build_id": "OSPREY_CI_BUILD_ID",
    "image_digest": "OSPREY_IMAGE_DIGEST",
    "release": "OSPREY_CD_RELEASE",
    "pipeline": "OSPREY_CD_PIPELINE",
    "target": "OSPREY_CD_TARGET",
    "revision": "K_REVISION",
    "service": "K_SERVICE"
  },
  "gcloud_bin": "gcloud",
  "git_bin": "git",
  "command_timeout_seconds": 120,
  "exit_codes": {"ok": 0, "fail": 1, "transient": 75},
  "default_error_taxonomy": "GCLOUD_ERROR",
  "error_taxonomy": [
    {"taxonomy": "UNAUTHENTICATED", "transient": false, "patterns": ["\\b401\\b", "UNAUTHENTICATED", "[Rr]eauthentication", "do not currently have an active account"]},
    {"taxonomy": "PERMISSION_DENIED", "transient": false, "patterns": ["\\b403\\b", "PERMISSION_DENIED", "[Pp]ermission denied"]},
    {"taxonomy": "RATE_LIMITED", "transient": true, "patterns": ["\\b429\\b", "RESOURCE_EXHAUSTED", "Too Many Requests", "[Qq]uota exceeded"]},
    {"taxonomy": "UNAVAILABLE", "transient": true, "patterns": ["\\b50[234]\\b", "\\bUNAVAILABLE\\b", "Service Unavailable", "DEADLINE_EXCEEDED", "[Cc]onnection (reset|aborted|refused)", "[Tt]imed out"]},
    {"taxonomy": "NOT_FOUND", "transient": false, "patterns": ["\\b404\\b", "NOT_FOUND", "could not be found"]},
    {"taxonomy": "FAILED_PRECONDITION", "transient": false, "patterns": ["FAILED_PRECONDITION", "ALREADY_EXISTS", "\\b409\\b"]}
  ],
  "formats": {
    "commit_sha": "^[0-9a-f]{40}$",
    "short_sha": "^[0-9a-f]{7}$",
    "short_sha_length": 7,
    "build_id": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "image_digest": "^sha256:[0-9a-f]{64}$",
    "resource_name": "^[a-z]([a-z0-9-]{0,61}[a-z0-9])?$",
    "resource_name_max_length": 63,
    "id_token": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
    "name_stamp": "%Y%m%d-%H%M%S"
  },
  "commands": {
    "git_status": ["{git}", "-C", "{source}", "status", "--porcelain", "--untracked-files=normal"],
    "git_head": ["{git}", "-C", "{source}", "rev-parse", "HEAD"],
    "build_submit": ["{gcloud}", "builds", "submit", "{source}", "--config={config_path}", "--project={project}", "--region={region}", "--substitutions=COMMIT_SHA={commit_sha},SHORT_SHA={short_sha}", "--async", "--format=value(id)"],
    "build_describe": ["{gcloud}", "builds", "describe", "{build_id}", "--project={project}", "--region={region}", "--format=json"],
    "artifact_cat": ["{gcloud}", "storage", "cat", "{artifact_uri}", "--project={project}"],
    "tag_describe": ["{gcloud}", "artifacts", "docker", "images", "describe", "{image_tag_ref}", "--project={project}", "--format=json"],
    "release_create": ["{gcloud}", "deploy", "releases", "create", "{release}", "--delivery-pipeline={pipeline}", "--region={region}", "--project={project}", "--source={source}", "--skaffold-file={skaffold_file}", "--images={image_name}={image_ref}", "--deploy-parameters=commit_sha={commit_sha},short_sha={short_sha},build_id={build_id},image_digest={image_digest},release={release}", "--quiet"],
    "releases_list": ["{gcloud}", "deploy", "releases", "list", "--delivery-pipeline={pipeline}", "--region={region}", "--project={project}", "--sort-by=~createTime", "--limit={limit}", "--format=json"],
    "rollouts_list": ["{gcloud}", "deploy", "rollouts", "list", "--release={release}", "--delivery-pipeline={pipeline}", "--region={region}", "--project={project}", "--format=json"],
    "rollout_describe": ["{gcloud}", "deploy", "rollouts", "describe", "{rollout}", "--release={release}", "--delivery-pipeline={pipeline}", "--region={region}", "--project={project}", "--format=json"],
    "target_rollback": ["{gcloud}", "deploy", "targets", "rollback", "{target}", "--delivery-pipeline={pipeline}", "--region={region}", "--project={project}", "--release={release}", "--rollout-id={rollout}", "--quiet"],
    "service_describe": ["{gcloud}", "run", "services", "describe", "{service}", "--region={region}", "--project={project}", "--format=json"],
    "revision_describe": ["{gcloud}", "run", "revisions", "describe", "{revision}", "--region={region}", "--project={project}", "--format=json"],
    "run_iam_policy": ["{gcloud}", "run", "services", "get-iam-policy", "{service}", "--region={region}", "--project={project}", "--format=json"],
    "iap_iam_policy": ["{gcloud}", "iap", "web", "get-iam-policy", "--resource-type=cloud-run", "--service={service}", "--region={region}", "--project={project}", "--format=json"]
  },
  "evidence": {
    "json_indent": 2,
    "s5_packet": ".workflow/evidence/s5_release_packet.json",
    "s6_deploy_report": ".workflow/evidence/s6_deploy_report.json",
    "s6_exit_reports": {
      "verify": ".workflow/evidence/s6_exit_report.json",
      "reprobe": ".workflow/evidence/s6_exit_reprobe_report.json",
      "preflight": ".workflow/evidence/s6_exit_preflight_report.json"
    },
    "ledger": ".workflow/evidence/workflow_ledger.jsonl"
  },
  "release_gate": {
    "packet_schema": "osprey-core/release-packet/v1",
    "packet_format_fields": ["commit_sha", "short_sha", "build_id", "image_digest"],
    "substitution_keys": {"commit_sha": "COMMIT_SHA", "short_sha": "SHORT_SHA"},
    "submit_timeout_seconds": 900,
    "poll_interval_seconds": 15,
    "max_wait_seconds": 2400,
    "success_status": "SUCCESS",
    "terminal_statuses": ["SUCCESS", "FAILURE", "INTERNAL_ERROR", "TIMEOUT", "CANCELLED", "EXPIRED"],
    "transient_statuses": ["INTERNAL_ERROR", "EXPIRED"],
    "failed_step_statuses": ["FAILURE", "TIMEOUT", "INTERNAL_ERROR", "CANCELLED"],
    "bounce_routes": {
      "guard-substitutions": "S4_VERIFY_QA",
      "unit-tests": "S3_BUILD",
      "docker-build": "S3_BUILD",
      "container-smoke": "S4_VERIFY_QA",
      "docker-push": "S3_BUILD",
      "release-packet": "S4_VERIFY_QA"
    },
    "default_bounce": "S3_BUILD",
    "crosscheck_bounce": "S4_VERIFY_QA",
    "artifact_prefix": "gs://gement02_cloudbuild/osprey-core/release-packets",
    "packet_artifact": "release_packet.json",
    "pytest_artifact": "pytest_report.txt",
    "pytest_passed_regex": "\\b([0-9]+) passed\\b",
    "pytest_failure_regex": "\\b(failed|errors?)\\b",
    "console_url_template": "https://console.cloud.google.com/cloud-build/builds;region={region}/{build_id}?project={project}"
  },
  "deploy": {
    "report_schema": "osprey-core/s6-deploy-report/v1",
    "release_name_template": "rel-{short_sha}-{stamp}",
    "create_timeout_seconds": 900,
    "poll_interval_seconds": 15,
    "max_wait_seconds": 1800,
    "success_state": "SUCCEEDED",
    "failed_states": ["FAILED", "CANCELLED", "CANCELLING", "HALTED", "APPROVAL_REJECTED"],
    "full_traffic_percent": 100,
    "urls_annotation": "run.googleapis.com/urls",
    "bounce_to": "S3_BUILD"
  },
  "exit_probe": {
    "report_schema": "osprey-core/s6-exit-report/v1",
    "modes": ["verify", "reprobe", "preflight"],
    "token_env_var": "IAP_TOKEN_COMMAND",
    "token_timeout_seconds": 60,
    "http_timeout_seconds": 20,
    "max_body_bytes": 1048576,
    "unauth_path": "/",
    "unauth_allowed_statuses": [302, 401],
    "redirect_statuses": [301, 302, 303, 307, 308],
    "unauth_redirect_hosts": ["accounts.google.com"],
    "auth_header": "Proxy-Authorization",
    "auth_scheme": "Bearer",
    "auth_paths": ["/", "/health", "/ready", "/api/pipeline"],
    "preflight_paths": ["/health"],
    "reprobe_paths": ["/", "/health", "/ready"],
    "provenance_path": "/api/pipeline",
    "provenance_key": "provenance",
    "packet_provenance_fields": ["commit_sha", "image_digest", "build_id"],
    "report_provenance_fields": ["release", "revision"],
    "ok_status": 200,
    "retry_statuses": [429, 500, 502, 503, 504],
    "cold_start_attempts": 6,
    "cold_start_delay_seconds": 10,
    "expected_service_annotations": {"run.googleapis.com/iap-enabled": "true", "run.googleapis.com/ingress": "all"},
    "expected_template_annotations": {"autoscaling.knative.dev/minScale": "1", "autoscaling.knative.dev/maxScale": "1"},
    "invoker_role": "roles/run.invoker",
    "accessor_role": "roles/iap.httpsResourceAccessor",
    "required_invoker_members": ["serviceAccount:osprey-onboard-sa@gement02.iam.gserviceaccount.com"],
    "required_accessor_members": ["serviceAccount:osprey-onboard-sa@gement02.iam.gserviceaccount.com"],
    "iap_agent_member_regex": "^serviceAccount:service-[0-9]+@gcp-sa-iap\\.iam\\.gserviceaccount\\.com$"
  },
  "cd_rollback": {
    "default_mode": "auto",
    "modes": ["auto", "deploy", "traffic"],
    "release_scan_limit": 10,
    "success_state": "SUCCEEDED",
    "rollout_id_template": "rollback-{stamp}",
    "transient_taxonomies": ["TIMEOUT", "POLL_DEADLINE"],
    "poll_interval_seconds": 15,
    "max_wait_seconds": 1200
  },
  "workflow": {
    "preflight_stage": "PREFLIGHT",
    "max_attempts": 4,
    "backoff_seconds": [15, 45, 120],
    "messages": {
      "bounce": "BOUNCE {stage} -> {route}",
      "rollback_bounce": "ROLLBACK & BOUNCE {stage} -> {route}",
      "close": "CLOSE {stage}",
      "halt": "HALT {stage}: {reason}",
      "incident": "INCIDENT {stage}: {reason}"
    },
    "status_ledger_tail": 10,
    "status_fields": {
      "packet": ["commit_sha", "short_sha", "build_id", "image_ref", "pytest_summary", "verified_at"],
      "deploy": ["ok", "release", "rollout", "state", "revision", "image", "new_revision_serving", "error_taxonomy"],
      "exit": ["ok", "mode", "serving_revision", "failed_checks", "error_taxonomy", "finished_at"]
    }
  }
}
